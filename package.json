{
  "name": "lilnotes",
  "private": true,
  "version": "0.3.0",
  "description": "Local-first macOS meeting recorder: on-device transcription, diarization and summaries.",
  "license": "AGPL-3.0-only",
  "author": "Johnny Xhama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxhama/lilnotes.git"
  },
  "homepage": "https://github.com/xxhama/lilnotes#readme",
  "bugs": {
    "url": "https://github.com/xxhama/lilnotes/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/build-llama-server.sh && tauri dev",
    "tauri:build": "bash scripts/build-llama-server.sh && tauri build && bash scripts/fix-bundle.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cd src-tauri && cargo test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4"
  }
}
