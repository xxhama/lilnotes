<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone input -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- App Sandbox stays off for v1: Core Audio process taps are fragile
	     under sandbox and there is no Mac App Store target. Hardened Runtime
	     is enabled at signing time for notarization (milestone 8). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
