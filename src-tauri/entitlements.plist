<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone input -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- App Sandbox stays off: Core Audio process taps are fragile under
	     sandbox and there is no Mac App Store target. Hardened Runtime is
	     applied at signing time by scripts/fix-bundle.sh (release builds);
	     audio-input above is the only entitlement it needs. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
